# Copy to .env and fill in real values before `docker compose up`:
#   cp .env.example .env

# JWT signing secret (JWT_SECRET). Generate a strong random value, e.g.:
#   openssl rand -base64 48
JWT_SECRET=please-generate-a-random-secret-with-openssl-rand-base64-48

# Elasticsearch password. Used by both the ES service and the app.
# NOTE: only applied when the es_data volume is first created; changing it
# later requires `docker compose down -v` (destroys ES data).
ES_PASSWORD=change-me
