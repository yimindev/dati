# ==============================================================================
# DatI 运行与部署环境配置模板
# 复制此文件为 .env 并在本地或生产环境中进行个性化配置：
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 核心安全配置（生产环境必填）
# ------------------------------------------------------------------------------
# JWT 签名密钥（生产环境请务必替换为随机强密钥，不少于 32 字符）
JWT_SECRET=your_jwt_secret_here_min_32_chars_long

# 默认系统管理员初始账号名（用户首次以此账号注册时自动赋予超级管理员权限）
ADMIN_USERS=admin

# ------------------------------------------------------------------------------
# 2. 存储与元数据库配置
# ------------------------------------------------------------------------------
# 元数据库类型：默认使用内置文件型 H2 数据库（容器内持久化在 volume dati_data）
# 如需对接外部生产 MySQL / RDS，取消下列注释并填入连接信息：
# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/dati?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai
# SPRING_DATASOURCE_USERNAME=root
# SPRING_DATASOURCE_PASSWORD=your_mysql_password

# ------------------------------------------------------------------------------
# 3. 语义检索引擎（Elasticsearch）配置
# ------------------------------------------------------------------------------
# Elasticsearch 访问密码（docker-compose 模式下必填）
SPRING_ELASTICSEARCH_PASSWORD=your_es_password_here
# SPRING_ELASTICSEARCH_URIS=http://elasticsearch:9200
# SPRING_ELASTICSEARCH_USERNAME=elastic

# ------------------------------------------------------------------------------
# 4. 资源配额与服务端口（Docker Compose）
# ------------------------------------------------------------------------------
DATI_PORT=8085
DATI_MEM_LIMIT=1536m
ES_PORT=9200
ES_MEM_LIMIT=1g
ES_HEAP=512m

# ------------------------------------------------------------------------------
# 5. 代码仓库与帮助中心链接配置（文档构建期 / 编译期）
# ------------------------------------------------------------------------------
# 项目代码远程仓库基准地址（私有化部署至企业内部 GitLab/Gitea 时，可在此修改）
# 默认值: https://github.com/yimindev/dati
REPO_URL=https://github.com/yimindev/dati

# dati-ops 技能目录地址（可选；默认自动由 REPO_URL 派生拼接: ${REPO_URL}/tree/main/skills/dati-ops）
# SKILL_URL=https://github.com/yimindev/dati/tree/main/skills/dati-ops
