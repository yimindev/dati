# Copy to .env and fill in real values before `docker compose up`:
#   cp .env.example .env

# JWT signing key: any long random text >= 32 chars that nobody can guess.
# Generate one with: openssl rand -base64 48
JWT_SECRET=please-set-a-long-random-secret-32-chars-min

# Elasticsearch password (single source of truth). Compose maps it to the ES
# container's ELASTIC_PASSWORD and the app's SPRING_ELASTICSEARCH_PASSWORD.
# NOTE: only applied when the es_data volume is first created; changing it
# later requires `docker compose down -v` (destroys ES data).
# NOTE: when running containers manually (docker run), pass
# SPRING_ELASTICSEARCH_PASSWORD to the app and ELASTIC_PASSWORD to the ES
# container with the same value.
SPRING_ELASTICSEARCH_PASSWORD=please-set-an-es-password

# --- Optional overrides (defaults fit a 2C4G box / out-of-the-box usage) ---
# Admin login names (registered users treated as platform admins)
# ADMIN_USERS=admin
# External platform database (RDS/MySQL etc.) instead of the embedded H2:
#   SPRING_DATASOURCE_URL=jdbc:mysql://host:3306/dati?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=utf8
#   SPRING_DATASOURCE_USERNAME=user
#   SPRING_DATASOURCE_PASSWORD=pass
# App container memory limit / ES heap + container limit (raise on bigger boxes)
# DATI_MEM_LIMIT=1536m
# ES_HEAP=512m
# ES_MEM_LIMIT=1g
# Host ports (override only on conflicts, e.g. running the dev backend on 8085)
# DATI_PORT=18085
# ES_PORT=9200
