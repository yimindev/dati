# ==============================================================================
# DatI Environment Configuration Template
# Copy this file to .env and adjust as needed:
#   cp .env.example .env
# ==============================================================================

# Security (Required for production)
# Strong secret key for signing JWT tokens (minimum 32 characters)
JWT_SECRET=your_jwt_secret_here_min_32_chars_long

# Initial super admin username (first user registering with this name receives admin role)
ADMIN_USERS=admin

# Storage & Database
# Default: Embedded H2 database persisted in volume 'dati_data'
# For external MySQL / RDS, uncomment and configure:
# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/dati?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai
# SPRING_DATASOURCE_USERNAME=root
# SPRING_DATASOURCE_PASSWORD=your_mysql_password

# Elasticsearch (Semantic Search Engine)
# Required for docker-compose deployment
SPRING_ELASTICSEARCH_PASSWORD=your_es_password_here
# SPRING_ELASTICSEARCH_URIS=http://elasticsearch:9200
# SPRING_ELASTICSEARCH_USERNAME=elastic

# Resource Budgets & Ports (Docker Compose)
DATI_PORT=8085
DATI_MEM_LIMIT=1536m
ES_PORT=9200
ES_MEM_LIMIT=1g
ES_HEAP=512m

# Repository & Documentation Links (Build time)
# Base repository URL for deriving documentation and skill links
REPO_URL=https://github.com/yimindev/dati

# Optional: Override dati-ops skill URL (defaults to ${REPO_URL}/tree/main/skills/dati-ops)
# SKILL_URL=https://github.com/yimindev/dati/tree/main/skills/dati-ops
